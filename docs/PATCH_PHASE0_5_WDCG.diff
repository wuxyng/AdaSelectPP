+                    topk=int(getattr(self, "wdcg_topk", 1000)),
+                    tau=float(getattr(self, "wdcg_tau", 0.05)),
+                    rho=float(getattr(self, "wdcg_rho", 0.7)),
+                    cap_family=int(getattr(self, "wdcg_cap_family", 2)),
+                    cols_per_table=int(getattr(self, "wdcg_cols_per_table", 12)),
+                    m_single=int(getattr(self, "wdcg_m_single", 8)),
+                    warmup_rounds=int(getattr(self, "wdcg_warmup_rounds", 0)),
+                    coverage_target=float(getattr(self, "wdcg_coverage_target", 0.90)),
+                    coverage_boost=bool(getattr(self, "wdcg_coverage_boost", False)),
+                )
+                self._last_wdcg_score_map = dict(res.wdcg_score_map)
+                self._last_wdcg_stats = {
+                    "candidate_count_raw": float(res.stats.candidate_count_raw),
+                    "wdcg_pruned_count": float(res.stats.wdcg_pruned_count),
+                    "coverage_ratio": float(res.stats.coverage_ratio),
+                }
+                return res.query_indexes, set(res.topk_set)
+            except Exception as e:
+                logger.warning("WDCG candidate funnel failed; falling back to baseline generation: %s", e)
+
+        query_indexes: List[Set[IndexKey]] = []
+        appearing: Set[IndexKey] = set()
+
+        for q in workload:
+            # Using store_indexable_columns from WorkloadParser
+            idx_map = self.parser.store_indexable_columns(q, self.tables)
+            q_set: Set[IndexKey] = set()
+
+            for tbl, cols in idx_map.items():
+                if not cols:
+                    continue
+                uniq_cols = _unique_preserve_order(cols)
+                up_to = min(self.max_width, len(uniq_cols))
+
+                for w in range(self.min_width, up_to + 1):
+                    for combo in itertools.permutations(uniq_cols, w):
+                        key: IndexKey = (tbl, combo)
+
+                        # Filter out existing primary/unique indexes
+                        if key in self._existing_indexes.get(tbl, set()):
+                            continue
+
+                        q_set.add(key)
+                        # Initialize benefit if new
+                        self.columns_benefit.setdefault(key, 0.0)
+
+            # Merge prefixes for this query's candidates
+            merged = _merge_prefixes(q_set)
+            query_indexes.append(merged)
+            appearing.update(merged)
+
+        # Merge prefixes for the global set of candidates
+        appearing = _merge_prefixes(appearing)
+        return query_indexes, appearing
+
+    # ---------------------------------------------------------
+    # Test Candidate
+    # ---------------------------------------------------------
+    def _test_candidate(
+            self,
+            idx_key: IndexKey,
+            query_indexes: List[Set[IndexKey]],
+            base_costs: List[float],
+            base_total: float,
+            old_conf: Set[IndexKey],
+            workload: List[str],
+    ) -> None:
+
+        tbl, cols = idx_key
+
+        # 1. Toggle Index State
+        try:
+            if idx_key in old_conf:
+                self.db_con2.disable_index(tbl, cols)
+            else:
+                self.db_con1.create_index(tbl, cols)
+        except Exception as e:
+            logger.warning("_test_candidate: toggle failed for %s: %s", idx_key, e)
+            return  # 不更新 benefit，保持旧值
+
+        # 2. Calculate Costs
+        total_cost = 0.0
+        try:
+
+            for i, (q_idxs, base_cost) in enumerate(zip(query_indexes, base_costs)):
+                if idx_key in q_idxs:
+                    self._m_stats["what_if_calls"] += 1
+                    try:
+                        c = self.cost_eval.calculate_now_cost([workload[i]])
+                        total_cost += c
+                    except Exception as e:
+                        logger.warning("what-if failed for q%d idx=%s: %s", i, idx_key, e)
+                        total_cost += base_cost
+                else:
+                    total_cost += base_cost
+        finally:
+            # 3. Restore Index State
+            try:
+                if idx_key in old_conf:
+                    self.db_con2.enable_index(tbl, cols)
+                else:
+                    self.db_con1.drop_index(tbl, cols)
+            except Exception as e:
+                logger.warning("_test_candidate: restore failed for %s: %s", idx_key, e)
+
+        # 4. Calculate Observation
+        # [Fix 1] Allow negative delta to capture harmful indexes
+        if idx_key not in old_conf:
+            # New Index: Benefit = Cost_Without - Cost_With
+            # 如果 Cost_With 更大 (Regression)，Delta 为负
+            delta = base_total - total_cost
+        else:
+            # Existing Index: Benefit = Cost_Disabled - Cost_Enabled
+            # 如果 Cost_Enabled 更大 (Regression)，Delta 为负
+            delta = total_cost - base_total
+
+        # 5. Adaptive Update
+        prev = self.columns_benefit.get(idx_key, 0.0)
+
+        # Calculate Lambda (Handle Cold Start internally)
+        curr_lambda = self._calculate_adaptive_lambda(idx_key, prev, delta)
+        self.idx_alphas[idx_key] = curr_lambda
+
+        # EWMA Update
+        new_benefit = curr_lambda * prev + (1.0 - curr_lambda) * delta
+        self.columns_benefit[idx_key] = new_benefit
+        logger.debug("benefit %s: %.4f -> %.4f (Obs=%.4f, Lambda=%.2f)",
+                     idx_key, prev, new_benefit, delta, curr_lambda)
+
+        # ========= Optional debug trace (in-memory) =========
+        # Default OFF: only record when the caller explicitly populates `trace_indexes`.
+        # Phase 0.3/0.4 uses util.TraceRecorder (CSV) in main.py instead.
+        if idx_key in self.trace_indexes:
+            # RSFE & MAD 已在 _calculate_adaptive_lambda 里更新过
+            rsfe = self.idx_error_smooth.get(idx_key, 0.0)
+            mad = self.idx_abs_error_smooth.get(idx_key, 0.0)
+            eps = 1e-9
+            if mad < eps:
+                ts = 0.0
+            else:
+                ts = abs(rsfe) / (mad + eps)
+
+            # 轮次：这里使用当前 workload_count 作为“第几轮”
+            round_id = self.workload_count
+
+            # 方便 CSV 简单阅读：把索引 key 展开一下
+            tbl, cols = idx_key
+            cols_str = ",".join(cols)
+
+            self.trace_history.append({
+                "round": round_id,
+                "table": tbl,
+                "cols": cols_str,
+                "delta": delta,
+                "prediction": prev,
+                "rsfe": rsfe,
+                "mad": mad,
+                "ts": ts,
+                "lambda": curr_lambda,
+                "benefit": new_benefit,
+            })
+        # ========= trace 记录结束 =========
+
+    # ---------------------------------------------------------
+    # Estimate Benefits
+    # ---------------------------------------------------------
+
+    def _estimate_benefits(
+            self,
+            workload: List[str],
+            old_conf: Set[IndexKey],
+    ) -> None:
+        # Phase 0.3/0.4 trace helpers: reset per-round state.
+        self._last_evaluated_set.clear()
+        self._last_eval_order.clear()
+
+        # 1. Base costs (Current Configuration)
+        # 计算当前配置下的 Base Cost，作为所有 What-if 的基准
+        base_costs, base_total = self._initial_costs(workload)
+        # Expose per-round observed base cost for Phase 0.2 logging.
+        self._last_base_total = float(base_total)
+
+        # 1. Generate Candidates
+        # query_indexes: List[Set], appearing: Set
+        query_indexes, appearing = self._generate_and_merge_candidates(workload, old_conf=old_conf)
+
+        # Phase 0.2 A-metrics: track how many candidates were generated.
+        self._m_stats["candidate_count"] += len(appearing)
+        if not appearing:
+            return
+
+        # 2. Budgeting Logic (Aligned with your logic)
+        # 第一轮：全量测试 (Full Exploration)，建立初始基准
+        # 后续轮：按比例限制 (Exploitation)，节省开销
+        if self.workload_count == 0:
+            budget = len(appearing)
+        else:
+            budget = max(1, int(len(appearing) * self.ratio))
+
+        trials = 0
+        appearing_indexes = set()  # 记录本轮实际评估过的索引
+
+        # 3. Evaluate in descending current benefit (Exploitation Priority)
+        # 我们遍历所有已知索引（按历史收益排序），但只测试那些在当前 workload 中出现的。
+        # 这种逻辑确保了 budget 优先分配给“历史上表现好且当前也相关”的索引。
+
+        # 注意：_generate_and_merge_candidates 会把新发现的索引加入 columns_benefit 并设为 0.0
+        # 所以它们会在排序列表的末尾。
+        # 仅对出现在本轮 workload 中的索引进行排序（加上 old_conf）
+        relevant_keys = appearing.union(old_conf)
+        # 从 columns_benefit 中提取相关项，若无记录则默认为 0
+        relevant_items = [(k, self.columns_benefit.get(k, 0.0)) for k in relevant_keys]
+        if getattr(self, "wdcg_enabled", False) and getattr(self, "_last_wdcg_score_map", None):
+            mix = float(getattr(self, "wdcg_benefit_mix", 0.2))
+            score_map = self._last_wdcg_score_map or {}
+            sorted_candidates = sorted(
+                relevant_items,
+                key=lambda kv: (score_map.get(kv[0], 0.0) + mix * abs(kv[1])),
+                reverse=True,
+            )
+        else:
+            sorted_candidates = sorted(relevant_items, key=lambda kv: kv[1], reverse=True)
+
+        # Persist evaluation priority order (only candidates relevant to this workload).
+        self._last_eval_order = [k for k, _ in sorted_candidates if k in appearing]
+
+        for idx_key, _ in sorted_candidates:
+            if trials >= budget:
+                break
+
+            # [Optimization] 只测试当前 Batch 出现的索引
+            # 如果索引不在 appearing 中，说明本轮收益为 0，无需 What-if，直接衰减
+            if idx_key not in appearing:
+                continue
+
+            # 执行测试 (Differential Logic + Adaptive Lambda Update)
+            self._test_candidate(
+                idx_key, query_indexes, base_costs, base_total, old_conf, workload
+            )
+
+            self._last_evaluated_set.add(idx_key)
+            appearing_indexes.add(idx_key)
+            trials += 1
+
+        # Phase 0.2 A-metrics: number of candidates actually evaluated under the round budget.
+        self._m_stats["evaluated_count"] += trials
+
+        # 4. Adaptive Decay for Unseen/Untested Indexes
+        # 对于本轮未被评估的索引（要么没出现，要么被 Budget 截断），进行衰减
+        for key in list(self.columns_benefit.keys()):
+            if key not in appearing_indexes:
+                # 原来的 benefit 衰减逻辑
+                last_lambda = self.idx_alphas.get(key, self.alpha_init)
+                self.columns_benefit[key] *= last_lambda
+
+                # 让 RSFE/MAD 也逐步淡出（只在已存在时才衰减）
+                if key in self.idx_error_smooth:
+                    self.idx_error_smooth[key] *= self.rsfe_decay
+                if key in self.idx_abs_error_smooth:
+                    self.idx_abs_error_smooth[key] *= self.rsfe_decay
+
+    def _choose_config(self, old_conf: Set[IndexKey]) -> List[IndexKey]:
+        """Parent selection rule; unchanged semantics.
+        Only A‑metrics bookkeeping is added.
+        """
+        old_canon = {_canon(k) for k in old_conf}
+
+        # 1) normalize benefits
+        normalized = self._minmax_norm(self.columns_benefit)
+        #logger.debug("sorted normalized_benefits: %s", normalized)
+
+        # 2) subtract creation cost for new indexes
+        net_benefits: Dict[IndexKey, float] = {}
+        for key, val in normalized.items():
+            cost = 0.0
+            if key not in old_canon:
+                cost = self._creation_cost(key)
+            net_benefits[key] = val - cost
+
+        # 3) top‑K by net benefit
+        sorted_keys = sorted(net_benefits.items(), key=lambda x: x[1], reverse=True)
+        candidate_conf = {key for key, _ in sorted_keys[: self.max_num]}
+        #logger.debug("Pre‑transition pick: %s", sorted(candidate_conf))
+
+        # 4. Decision Logic
+        final_conf = old_canon  # Default to keep old
+        if not old_canon:
+            # First round: Always accept candidates (Cold Start)
+            final_conf = candidate_conf
+        else:
+            # Subsequent rounds: Beta Transition Logic
+            old_benefit = sum(net_benefits.get(k, 0.0) for k in old_canon)
+            new_benefit = sum(net_benefits.get(k, 0.0) for k in candidate_conf)
+
+            ratio = float("-inf")
+            # Case A: Both Positive -> Standard Ratio
+            if old_benefit > 1e-9 and new_benefit > 1e-9:
+                ratio = new_benefit / old_benefit
+            # Case B: Both Negative -> "Less Bad" Ratio
+            # Logic: If Old=-10, New=-5, Ratio=2.0 (>1.1). Switch.
+            elif old_benefit < -1e-9 and new_benefit < -1e-9:
+                ratio = abs(old_benefit) / abs(new_benefit)
+            # Case C: Negative to Positive -> Always Switch
+            elif old_benefit < -1e-9 and new_benefit > 1e-9:
+                ratio = float("inf")
+            elif abs(old_benefit) <= 1e-9 and new_benefit > 1e-9:
+                # 从“基本 0 收益”跳到“明显正收益”
+                ratio = float("inf")
+            # 其他情况保持 -inf，相当于“不要切换”
+
+            logger.info(f"Ratio={ratio:.2f} (Old={old_benefit:.2f}, New={new_benefit:.2f})")
+            if ratio > self.beta:
+                final_conf = candidate_conf
+                logger.info(f"Transition triggered")
+
+        # 5. Metrics Recording (Unified)
+        # Calculate diff based on FINAL decision
+        add_set = final_conf - old_canon
+        drop_set = old_canon - final_conf
+
+        self._m_stats["reconf_add"] += len(add_set)
+        self._m_stats["reconf_drop"] += len(drop_set)
+
+        # Track creation cost incurred by this transition
+        trans_create_cost = sum(self._creation_cost(k) for k in add_set)
+        self._m_stats["trans_create"] += trans_create_cost
+
+        # Log summary
+        logger.info(
+            "Round %d Decision | Add: %d, Drop: %d, Cost: %.2f | Total What-If: %d",
+            self.workload_count, len(add_set), len(drop_set), trans_create_cost,
+            self._m_stats["what_if_calls"]
+        )
+
+        return sorted(final_conf)
+
+    def _handle_timeout_policy(
+            self,
+            runtimes: List[int],
+            old_conf: Set[IndexKey]
+    ) -> Optional[Set[IndexKey]]:
+        """
+        处理超时逻辑。
+        Returns:
+            - None: 需要执行正常的 Profile & Select 流程 (包含 Hard Reset 后的重新冷启动)。
+            - Set[IndexKey]: 强制决定的配置 (用于 Level 1/2 的快速止损)，跳过本轮评估。
+        """
+        is_timeout = any(rt >= self.timeout for rt in runtimes)
+
+        # --- Case A: 正常运行 ---
+        if not is_timeout:
+            self.consecutive_timeouts = 0
+            self.last_stable_config = old_conf.copy()
+            return None
+
+        # --- Case B: 触发超时 ---
+        self.consecutive_timeouts += 1
+        logger.warning(f"Timeout detected! Consecutive count: {self.consecutive_timeouts}")
+
+        # 策略 Level 3: 核按钮 (Hard Reset) - 连续 3 次超时
+        # 逻辑修正：重置状态，但让 run() 继续执行，根据当前 workload 重新生成索引
+        if self.consecutive_timeouts >= 3:
+            logger.critical("System critical. Resetting state and triggering COLD START.")
+            try:
+                # 物理删除所有索引，确保数据库回到干净状态
+                self.db_con2.drop_all_indexes()
+            except Exception as e:
+                logger.error(f"Failed to drop all indexes: {e}")
+
+            # 清空所有记忆
+            old_conf.clear()
+            self.columns_benefit.clear()
+            self.idx_error_smooth.clear()
+            self.idx_abs_error_smooth.clear()
+
+            # 关键：重置计数器，这将触发 _estimate_benefits 中的"第一轮全量探索"逻辑
+            self.workload_count = 0
+            self.consecutive_timeouts = 0
+            self.last_stable_config.clear()
+
+            # 返回 None，指示 run() 继续往下走，去执行 _estimate_benefits
+            # 这样 $S_t$ 就会基于 $W_t$ 生成，而不是空的
+            return None
+
+            # 策略 Level 2: 回滚 (Rollback) - 连续 2 次超时
+        if self.consecutive_timeouts == 2 and self.last_stable_config:
+            logger.warning("Rolling back to last stable config.")
+            return self.last_stable_config.copy()
+
+        # 策略 Level 1: 快速止损 (Fast Penalty) - 偶发超时
+        # 对当前索引进行惩罚，然后快速选出一个子集，跳过昂贵的 what-if
+        penalty_factor = 0.5
+        for idx in list(self.columns_benefit.keys()):
+            if idx in old_conf:
+                # 自适应调整 Lambda (模拟一次极差观测)
+                prev_b = self.columns_benefit.get(idx, 0.0)
+                curr_lambda = self._calculate_adaptive_lambda(idx, prev_b, 0.0)
+                self.idx_alphas[idx] = curr_lambda
+                # 惩罚 Benefit
+                self.columns_benefit[idx] *= penalty_factor
+
+        logger.info("Level 1 timeout: Applying penalty and fast selecting.")
+        # 直接返回选择结果，跳过 _estimate_benefits (保护数据库)
+        return self._choose_config(old_conf)
+
+    def run(
+            self,
+            workload: List[str],
+            old_conf: Set[IndexKey],
+            runtimes: List[int],
+    ) -> Set[IndexKey]:
+
+        # 1. 处理超时
+        # 如果是 Hard Reset，这里返回 None，old_conf 被清空，workload_count=0
+        forced_decision = self._handle_timeout_policy(runtimes, old_conf)
+
+        if forced_decision is not None:
+            return forced_decision
+
+        # 2. 正常流程 (含 Hard Reset 后的冷启动)
+        # 如果是 Reset 之后走到这里，workload_count 为 0
+        # _estimate_benefits 会执行全量 Budget 的探索，为下一轮生成最佳推荐
+        self._estimate_benefits(workload, old_conf)
+
+        selected = self._choose_config(old_conf)
+        self.workload_count += 1
+        return set(selected)
