+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, Iterable, List, Optional, Set, Tuple
+
+from .template_extractor import QueryInfo
+
+IndexKey = Tuple[str, Tuple[str, ...]]  # (table, (col1, col2, ...))
+
+
+@dataclass
+class FamilyMeta:
+    """Prefix-family metadata (order-sensitive).
+
+    v1.1 intentionally avoids set-signature deduplication. Families are defined
+    by B-tree *prefix* (canonical ordering), which is safe under order-sensitive
+    keys.
+    """
+
+    family_id: Dict[IndexKey, int]
+    parent: Dict[IndexKey, Optional[IndexKey]]
+
+
+@dataclass
+class EnumStats:
+    candidate_count_raw: int = 0
+    candidate_count_after_filters: int = 0
+
+
+class CooccurrenceEnumerator:
+    """Enumerate width<=2 candidates using co-occurrence + AIM-style ordering.
+
+    - Uses only predicate/join/order/group columns to avoid payload explosion.
+    - Produces order-sensitive IndexKey using canonical ordering.
+    """
+
+    def __init__(
+        self,
+        tau_cooc: float = 0.05,
+        top_l_cols_per_table: int = 12,
+        top_m_single: int = 8,
+        enable_payload: bool = False,
+    ) -> None:
+        self.tau_cooc = float(tau_cooc)
+        self.top_l_cols_per_table = int(top_l_cols_per_table)
+        self.top_m_single = int(top_m_single)
+        self.enable_payload = bool(enable_payload)
+
+        # stats across the workload (per round)
+        self.freq: Dict[Tuple[str, str], float] = {}
+        self.cooc: Dict[Tuple[str, str, str], float] = {}
+        self.role_count: Dict[Tuple[str, str, str], int] = {}
+
+    # -------------------------
+    # Public API
+    # -------------------------
+
+    def enumerate(
+        self, query_infos: List[QueryInfo], extra_keys: Optional[Iterable[IndexKey]] = None
+    ) -> Tuple[Dict[int, List[IndexKey]], Set[IndexKey], FamilyMeta, EnumStats]:
+        """Return (cands_by_query, all_cands, family_meta, stats)."""
+
+        self._reset_stats()
+        self._collect_stats(query_infos)
+
+        cands_by_query: Dict[int, List[IndexKey]] = {}
+        all_cands: Set[IndexKey] = set()
+        family_id: Dict[IndexKey, int] = {}
+        parent: Dict[IndexKey, Optional[IndexKey]] = {}
+
+        next_family = 0
+
+        for qi in query_infos:
+            per_q: List[IndexKey] = []
+
+            for tbl, roles in qi.roles.items():
+                # Layer-1 weak column pruning: Top-L per table, role-aware
+                cols_ranked = self._rank_cols_for_table(tbl)
+                top_cols = cols_ranked[: self.top_l_cols_per_table]
+
+                # singles
+                for c in top_cols[: self.top_m_single]:
+                    key = (tbl, (c,))
+                    per_q.append(key)
+
+                # pairs via cooc
+                n = len(top_cols)
+                for i in range(n):
+                    for j in range(i + 1, n):
+                        c1, c2 = top_cols[i], top_cols[j]
+                        if not self._pass_cooc(tbl, c1, c2):
+                            continue
+
+                        # AIM partial order canonicalization is query-specific
+                        key = self._canonical_pair(tbl, (c1, c2), qi)
+                        if key is None:
+                            continue
+                        per_q.append(key)
+
+            # de-dup within query
+            uniq = []
+            seen = set()
+            for k in per_q:
+                if k not in seen:
+                    uniq.append(k)
+                    seen.add(k)
+            cands_by_query[qi.qid] = uniq
+            all_cands.update(uniq)
+
+        # Always keep extra keys (e.g., old configuration) as candidates.
+        if extra_keys:
+            for k in extra_keys:
+                all_cands.add(k)
+
+        # Build prefix family meta (order-sensitive)
+        for k in all_cands:
+            if k not in family_id:
+                family_id[k] = next_family
+                next_family += 1
+            # parent is the immediate prefix (len-1) if exists, else None
+            tbl, cols = k
+            if len(cols) <= 1:
+                parent[k] = None
+            else:
+                p = (tbl, cols[:1])
+                parent[k] = p
+                # ensure parent exists and shares family id
+                if p not in family_id:
+                    family_id[p] = family_id[k]
+                else:
+                    family_id[k] = family_id[p]
+
+        stats = EnumStats(candidate_count_raw=len(all_cands), candidate_count_after_filters=len(all_cands))
+        return cands_by_query, all_cands, FamilyMeta(family_id=family_id, parent=parent), stats
+
+    # -------------------------
+    # Internal helpers
+    # -------------------------
+
+    def _reset_stats(self) -> None:
+        self.freq.clear()
+        self.cooc.clear()
+        self.role_count.clear()
+
+    def _collect_stats(self, query_infos: List[QueryInfo]) -> None:
+        for qi in query_infos:
+            for tbl, roles in qi.roles.items():
+                # Only predicate/join/order/group by default; payload excluded to avoid explosion.
+                cols: Set[str] = set(roles.join_eq) | set(roles.filter_eq) | set(roles.filter_rng) | set(roles.order_by) | set(roles.group_by)
+                if self.enable_payload:
+                    cols |= set(roles.payload)
+
+                # role counts for pruning/ranking
+                for c in roles.join_eq:
+                    self._inc_role(tbl, c, "join_eq")
+                for c in roles.filter_eq:
+                    self._inc_role(tbl, c, "filter_eq")
+                for c in roles.filter_rng:
+                    self._inc_role(tbl, c, "filter_rng")
+                for c in roles.order_by:
+                    self._inc_role(tbl, c, "order_by")
+                for c in roles.group_by:
+                    self._inc_role(tbl, c, "group_by")
+                if self.enable_payload:
+                    for c in roles.payload:
+                        self._inc_role(tbl, c, "payload")
+
+                for c in cols:
+                    self.freq[(tbl, c)] = self.freq.get((tbl, c), 0.0) + 1.0
+
+                cols_list = sorted(cols)
+                for i in range(len(cols_list)):
+                    for j in range(i + 1, len(cols_list)):
+                        c1, c2 = cols_list[i], cols_list[j]
+                        self.cooc[(tbl, c1, c2)] = self.cooc.get((tbl, c1, c2), 0.0) + 1.0
+
+    def _inc_role(self, tbl: str, col: str, role: str) -> None:
+        key = (tbl, col, role)
+        self.role_count[key] = self.role_count.get(key, 0) + 1
+
+    def _rank_cols_for_table(self, tbl: str) -> List[str]:
+        # Weighted role score (v1.1 defaults)
+        def role_score(c: str) -> float:
+            return (
+                5.0 * self.role_count.get((tbl, c, "join_eq"), 0)
+                + 4.0 * self.role_count.get((tbl, c, "filter_eq"), 0)
+                + 3.0 * self.role_count.get((tbl, c, "filter_rng"), 0)
+                + 2.0 * self.role_count.get((tbl, c, "order_by"), 0)
+                + 1.0 * self.role_count.get((tbl, c, "group_by"), 0)
+            )
+
+        cols = [c for (t, c) in self.freq.keys() if t == tbl]
+        cols.sort(key=lambda c: (role_score(c), self.freq.get((tbl, c), 0.0), c), reverse=True)
+        return cols
+
+    def _pass_cooc(self, tbl: str, c1: str, c2: str) -> bool:
+        a, b = (c1, c2) if c1 < c2 else (c2, c1)
+        co = self.cooc.get((tbl, a, b), 0.0)
+        f1 = self.freq.get((tbl, c1), 0.0)
+        f2 = self.freq.get((tbl, c2), 0.0)
+        denom = max(1.0, min(f1, f2))
+        ratio = co / denom
+        return ratio >= self.tau_cooc
+
+    def _canonical_pair(self, tbl: str, cols: Tuple[str, str], qi: QueryInfo) -> Optional[IndexKey]:
+        # Prune pure-payload pairs (v1.1 safe rule)
+        roles = qi.roles.get(tbl)
+        if roles is None:
+            return None
+        predicate_cols = set(roles.join_eq) | set(roles.filter_eq) | set(roles.filter_rng) | set(roles.order_by) | set(roles.group_by)
+        if cols[0] not in predicate_cols and cols[1] not in predicate_cols:
+            return None
+
+        ordered = self._canonical_order(cols, qi, tbl)
+        return (tbl, ordered)
+
+    def _canonical_order(self, cols: Iterable[str], qi: QueryInfo, tbl: str) -> Tuple[str, ...]:
+        """AIM-style partial order canonicalization.
+
+        Equality (IPP: join_eq/filter_eq) -> Range -> Group/Order -> Payload.
+        Within each bucket, deterministic ordering by (role_priority, -freq, lex).
+        """
+
+        roles = qi.roles.get(tbl)
+        if roles is None:
+            return tuple(sorted(cols))
+
+        eq_set = set(roles.join_eq) | set(roles.filter_eq)
+        rng_set = set(roles.filter_rng)
+        go_set = set(roles.group_by) | set(roles.order_by)
+        payload_set = set(roles.payload)
+
+        def bucket(c: str) -> int:
+            if c in eq_set:
+                return 0
+            if c in rng_set:
+                return 1
+            if c in go_set:
+                return 2
+            if c in payload_set:
+                return 3
+            return 2
+
+        def pri(c: str) -> Tuple[int, float, str]:
+            # freq descending
+            return (bucket(c), -self.freq.get((tbl, c), 0.0), c)
+
+        ordered = sorted(list(cols), key=pri)
+        return tuple(ordered)
