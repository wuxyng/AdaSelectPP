+    def _generate_and_merge_candidates(
+            self, workload: List[str], old_conf: Optional[Set[IndexKey]] = None
+    ) -> Tuple[List[Set[IndexKey]], Set[IndexKey]]:
+        """
+        Generates candidate indexes for the workload.
+        Returns:
+            query_indexes: List of sets, where index i contains candidates relevant to workload[i].
+            appearing: Set of all unique candidates generated in this batch.
+        """
+        # Phase 0.5 (WDCG) candidate funnel: optional fast path.
