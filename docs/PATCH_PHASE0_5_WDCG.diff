@@ -0,0 +1,320 @@
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Set, Tuple
+
+
+@dataclass
+class RoleCols:
+    join_eq: List[str] = field(default_factory=list)
+    filter_eq: List[str] = field(default_factory=list)
+    filter_rng: List[str] = field(default_factory=list)
+    order_by: List[str] = field(default_factory=list)
+    group_by: List[str] = field(default_factory=list)
+    payload: List[str] = field(default_factory=list)
+
+
+@dataclass
+class QueryInfo:
+    qid: int
+    template_id: str
+    tables: Set[str]
+    roles: Dict[str, RoleCols]
+    weight: float = 1.0
+    plan_sig: Optional[str] = None
+
+
+_KW_SPLIT_RE = re.compile(r"\b(where|group\s+by|order\s+by|having|limit)\b", re.IGNORECASE)
+_FROM_JOIN_RE = re.compile(
+    r"\b(from|join)\s+([a-zA-Z_][\w\.]*)(?:\s+(?:as\s+)?)?([a-zA-Z_][\w]*)?",
+    re.IGNORECASE,
+)
+_COLREF_RE = re.compile(r"([a-zA-Z_][\w]*)\.([a-zA-Z_][\w]*)")
+_EQ_OP_RE = re.compile(r"=|\b(in)\b|\b(is)\b", re.IGNORECASE)
+_RNG_OP_RE = re.compile(r"<=|>=|<|>|\b(between)\b|\b(like)\b", re.IGNORECASE)
+
+
+def _strip_sql_comments(sql: str) -> str:
+    # Remove /* ... */ and -- ... endline
+    sql = re.sub(r"/\*.*?\*/", " ", sql, flags=re.DOTALL)
+    sql = re.sub(r"--.*?$", " ", sql, flags=re.MULTILINE)
+    return sql
+
+
+def _norm_table_name(name: str) -> str:
+    # Strip schema if present
+    return name.split(".")[-1]
+
+
+def _dedup_keep_order(cols: List[str]) -> List[str]:
+    seen = set()
+    out: List[str] = []
+    for c in cols:
+        if c not in seen:
+            seen.add(c)
+            out.append(c)
+    return out
+
+
+class TemplateExtractor:
+    """Extract QueryInfo with lightweight role classification.
+
+    v1.1 supports two modes:
+      - SQL mode (default): parse roles from SQL text only.
+      - PLAN mode (optional): use DatabaseConnector.get_plan() (EXPLAIN JSON)
+        to extract roles and plan_sig. This is a stepping stone toward plan
+        embeddings in later phases.
+    """
+
+    def __init__(self, use_plan: bool = False, db_con=None, join_depth: int = 1):
+        self.use_plan = bool(use_plan)
+        self.db_con = db_con
+        self.join_depth = int(join_depth)
+        self._plan_cache: Dict[str, dict] = {}
+
+    def extract(self, workload_lines: List[str]) -> List[QueryInfo]:
+        infos: List[QueryInfo] = []
+        for i, line in enumerate(workload_lines):
+            sql, tid = self._split_line(line, i)
+            sql_clean = _strip_sql_comments(sql)
+            qi = self._extract_from_sql(i, tid, sql_clean)
+            if self.use_plan and self.db_con is not None:
+                try:
+                    plan = self._get_plan_cached(sql)
+                    self._augment_from_plan(qi, plan)
+                except Exception:
+                    # PLAN-mode is best-effort; fall back silently.
+                    pass
+            # finalize
+            for t, rc in qi.roles.items():
+                rc.join_eq = _dedup_keep_order(rc.join_eq)
+                rc.filter_eq = _dedup_keep_order(rc.filter_eq)
+                rc.filter_rng = _dedup_keep_order(rc.filter_rng)
+                rc.order_by = _dedup_keep_order(rc.order_by)
+                rc.group_by = _dedup_keep_order(rc.group_by)
+                rc.payload = _dedup_keep_order(rc.payload)
+            infos.append(qi)
+        return infos
+
+    @staticmethod
+    def _split_line(line: str, qid: int) -> Tuple[str, str]:
+        # workload may be "SQL\tTEMPLATE" or just "SQL"
+        parts = line.split("\t")
+        if len(parts) >= 2:
+            return parts[0].strip(), parts[1].strip()
+        return line.strip(), f"q{qid}"
+
+    def _extract_from_sql(self, qid: int, template_id: str, sql: str) -> QueryInfo:
+        sql_l = sql.lower()
+        alias2table = self._extract_aliases(sql)
+        tables = set(alias2table.values())
+
+        roles: Dict[str, RoleCols] = {t: RoleCols() for t in tables}
+
+        # crude clause split
+        clauses = self._split_clauses(sql)
+        on_parts = clauses.get("on", [])
+        where_part = clauses.get("where", "")
+        group_part = clauses.get("group by", "")
+        order_part = clauses.get("order by", "")
+        select_part = clauses.get("select", "")
+
+        # join conditions from ON
+        for on in on_parts:
+            for a1, c1, a2, c2 in self._extract_join_eq_pairs(on):
+                t1 = alias2table.get(a1)
+                t2 = alias2table.get(a2)
+                if t1:
+                    roles[t1].join_eq.append(c1)
+                if t2:
+                    roles[t2].join_eq.append(c2)
+
+        # where predicates: classify by operator
+        for a, c, op_kind in self._extract_pred_cols(where_part):
+            t = alias2table.get(a)
+            if not t:
+                continue
+            if op_kind == "eq":
+                roles[t].filter_eq.append(c)
+            elif op_kind == "rng":
+                roles[t].filter_rng.append(c)
+
+        # group/order
+        for a, c in self._extract_cols(group_part):
+            t = alias2table.get(a)
+            if t:
+                roles[t].group_by.append(c)
+        for a, c in self._extract_cols(order_part):
+            t = alias2table.get(a)
+            if t:
+                roles[t].order_by.append(c)
+
+        # payload (select list)
+        for a, c in self._extract_cols(select_part):
+            t = alias2table.get(a)
+            if t:
+                roles[t].payload.append(c)
+
+        return QueryInfo(qid=qid, template_id=template_id, tables=tables, roles=roles)
+
+    @staticmethod
+    def _extract_aliases(sql: str) -> Dict[str, str]:
+        alias2table: Dict[str, str] = {}
+        for _, tbl, alias in _FROM_JOIN_RE.findall(sql):
+            t = _norm_table_name(tbl)
+            a = (alias or t).strip()
+            alias2table[a] = t
+        return alias2table
+
+    @staticmethod
+    def _split_clauses(sql: str) -> Dict[str, object]:
+        # Extremely lightweight: assume SELECT ... FROM ... [WHERE ...] ...
+        out: Dict[str, object] = {"select": "", "where": "", "group by": "", "order by": "", "on": []}
+        s = sql.strip()
+        m = re.search(r"\bselect\b(.*)\bfrom\b", s, flags=re.IGNORECASE | re.DOTALL)
+        if m:
+            out["select"] = m.group(1)
+        # collect ON segments
+        on_segs = re.split(r"\bon\b", s, flags=re.IGNORECASE)
+        if len(on_segs) > 1:
+            # parts after each ON until next JOIN/WHERE/GROUP/ORDER
+            tails = on_segs[1:]
+            for tail in tails:
+                # cut at next keyword that likely terminates ON clause
+                cut = _KW_SPLIT_RE.split(tail, maxsplit=1)
+                out["on"].append(cut[0])
+        # where/group/order
+        m = re.search(r"\bwhere\b(.*)", s, flags=re.IGNORECASE | re.DOTALL)
+        if m:
+            tail = m.group(1)
+            cut = _KW_SPLIT_RE.split(tail, maxsplit=1)
+            out["where"] = cut[0]
+        m = re.search(r"\bgroup\s+by\b(.*)", s, flags=re.IGNORECASE | re.DOTALL)
+        if m:
+            tail = m.group(1)
+            cut = _KW_SPLIT_RE.split(tail, maxsplit=1)
+            out["group by"] = cut[0]
+        m = re.search(r"\border\s+by\b(.*)", s, flags=re.IGNORECASE | re.DOTALL)
+        if m:
+            tail = m.group(1)
+            cut = _KW_SPLIT_RE.split(tail, maxsplit=1)
+            out["order by"] = cut[0]
+        return out
+
+    @staticmethod
+    def _extract_join_eq_pairs(on_sql: str) -> List[Tuple[str, str, str, str]]:
+        # match patterns like a.col = b.col
+        pairs: List[Tuple[str, str, str, str]] = []
+        for m in re.finditer(r"([a-zA-Z_][\w]*)\.([a-zA-Z_][\w]*)\s*=\s*([a-zA-Z_][\w]*)\.([a-zA-Z_][\w]*)", on_sql):
+            pairs.append((m.group(1), m.group(2), m.group(3), m.group(4)))
+        return pairs
+
+    @staticmethod
+    def _extract_cols(seg_sql: str) -> List[Tuple[str, str]]:
+        return [(a, c) for a, c in _COLREF_RE.findall(seg_sql or "")]
+
+    @staticmethod
+    def _extract_pred_cols(where_sql: str) -> List[Tuple[str, str, str]]:
+        # Return (alias, col, kind) where kind in {eq,rng}
+        out: List[Tuple[str, str, str]] = []
+        if not where_sql:
+            return out
+        # Split on AND/OR to reduce noise
+        parts = re.split(r"\band\b|\bor\b", where_sql, flags=re.IGNORECASE)
+        for p in parts:
+            cols = _COLREF_RE.findall(p)
+            if not cols:
+                continue
+            kind = None
+            if _EQ_OP_RE.search(p):
+                kind = "eq"
+            elif _RNG_OP_RE.search(p):
+                kind = "rng"
+            if kind is None:
+                continue
+            # pick leftmost column reference in this predicate
+            a, c = cols[0]
+            out.append((a, c, kind))
+        return out
+
+    def _get_plan_cached(self, sql: str) -> dict:
+        if sql in self._plan_cache:
+            return self._plan_cache[sql]
+        plan = self.db_con.get_plan(sql)
+        self._plan_cache[sql] = plan
+        return plan
+
+    def _augment_from_plan(self, qi: QueryInfo, plan: dict) -> None:
+        # Extract table-qualified col refs from plan fields.
+        role_map: Dict[str, RoleCols] = {t: qi.roles.get(t, RoleCols()) for t in qi.tables}
+
+        def visit(node: dict):
+            for k in ("Hash Cond", "Merge Cond", "Join Filter"):
+                if k in node and isinstance(node[k], str):
+                    for t, c in self._extract_plan_cols(node[k]):
+                        if t in role_map:
+                            role_map[t].join_eq.append(c)
+            for k in ("Filter", "Index Cond", "Recheck Cond"):
+                if k in node and isinstance(node[k], str):
+                    # classify as eq/rng roughly
+                    kind = "eq" if _EQ_OP_RE.search(node[k]) else ("rng" if _RNG_OP_RE.search(node[k]) else None)
+                    for t, c in self._extract_plan_cols(node[k]):
+                        if t in role_map and kind == "eq":
+                            role_map[t].filter_eq.append(c)
+                        elif t in role_map and kind == "rng":
+                            role_map[t].filter_rng.append(c)
+            for k in ("Sort Key",):
+                if k in node and isinstance(node[k], list):
+                    for item in node[k]:
+                        if isinstance(item, str):
+                            for t, c in self._extract_plan_cols(item):
+                                if t in role_map:
+                                    role_map[t].order_by.append(c)
+            for k in ("Group Key",):
+                if k in node and isinstance(node[k], list):
+                    for item in node[k]:
+                        if isinstance(item, str):
+                            for t, c in self._extract_plan_cols(item):
+                                if t in role_map:
+                                    role_map[t].group_by.append(c)
+            for k in ("Output",):
+                if k in node and isinstance(node[k], list):
+                    for item in node[k]:
+                        if isinstance(item, str):
+                            for t, c in self._extract_plan_cols(item):
+                                if t in role_map:
+                                    role_map[t].payload.append(c)
+            for child in node.get("Plans", []) or []:
+                if isinstance(child, dict):
+                    visit(child)
+
+        visit(plan)
+        qi.roles = role_map
+        qi.tables = set(role_map.keys())
+        qi.plan_sig = self._plan_signature(plan)
+
+    @staticmethod
+    def _extract_plan_cols(expr: str) -> List[Tuple[str, str]]:
+        # plan strings often contain table.col
+        out = []
+        for t, c in _COLREF_RE.findall(expr or ""):
+            out.append((_norm_table_name(t), c))
+        return out
+
+    @staticmethod
+    def _plan_signature(plan: dict) -> str:
+        # cheap, deterministic signature for later clustering
+        ops: List[str] = []
+
+        def visit(n: dict):
+            nt = n.get("Node Type")
+            if isinstance(nt, str):
+                ops.append(nt)
+            for ch in n.get("Plans", []) or []:
+                if isinstance(ch, dict):
+                    visit(ch)
+
+        visit(plan)
+        s = ">".join(ops[:64])
+        return str(abs(hash(s)))
