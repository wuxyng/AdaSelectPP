+        # (optional) log wall-clock of executing queries (for debugging)
+        logger.info(
+            "round=%s exec_ms=%.2f exec_wall_ms=%.2f rec_ms=%.2f trans_ms=%.2f total_ms=%.2f switched=%s timeout=%s",
+            rid,
