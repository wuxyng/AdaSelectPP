@@ -0,0 +1,219 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Sequence, Set, Tuple
+
+from .enumerator import CooccurrenceEnumerator, FamilyMeta, IndexKey
+from .ranker import WDCGRanker, WDCGDebug
+from .template_extractor import QueryInfo, TemplateExtractor
+
+
+@dataclass
+class CandidateStats:
+    candidate_count_raw: int
+    wdcg_pruned_count: int
+    coverage_ratio: float
+    skipped_family_cap: int = 0
+    skipped_dominated: int = 0
+
+
+@dataclass
+class CandidateResult:
+    topk: Set[IndexKey]
+    candidates_by_table: Dict[str, List[IndexKey]]
+    query_indexes: List[Set[IndexKey]]
+    wdcg_score: Dict[IndexKey, float]
+    family_meta: FamilyMeta
+    stats: CandidateStats
+    debug: Optional[WDCGDebug] = None
+
+
+class CandidateGenerator:
+    """Phase 0.5 WDCG candidate funnel (v1.1).
+
+    This generator is used as a *candidate evaluation* plugin:
+    it outputs a compact candidate set (Top-K) and a table-partitioned evaluation order.
+    """
+
+    def __init__(
+        self,
+        extractor: TemplateExtractor,
+        enumerator: Optional[CooccurrenceEnumerator] = None,
+        ranker: Optional[WDCGRanker] = None,
+        topk: int = 1000,
+        cap_family: int = 2,
+        target_coverage: float = 0.90,
+        enable_coverage_boost: bool = True,
+    ):
+        self.extractor = extractor
+        self.enumerator = enumerator or CooccurrenceEnumerator()
+        self.ranker = ranker or WDCGRanker()
+        self.topk = int(topk)
+        self.cap_family = int(cap_family)
+        self.target_coverage = float(target_coverage)
+        self.enable_coverage_boost = bool(enable_coverage_boost)
+
+    def generate(
+        self,
+        workload_sqls: Sequence[str],
+        old_conf: Set[IndexKey],
+        mu_smooth: Dict[IndexKey, float],
+    ) -> CandidateResult:
+        query_infos: List[QueryInfo] = self.extractor.extract(list(workload_sqls))
+
+        # Enumerate candidates
+        cands_by_query, family_meta, freq = self.enumerator.enumerate(query_infos, old_conf=old_conf)
+
+        # Rank with WDCG
+        score_map, debug = self.ranker.score(
+            query_infos=query_infos,
+            cands_by_query=cands_by_query,
+            mu_smooth=mu_smooth,
+            freq=freq,
+            family_meta=family_meta,
+        )
+
+        # Select global Top-K with constraints
+        topk_set, skip_family, skip_dom = self._select_topk(score_map, family_meta, query_infos, cands_by_query)
+
+        # Build per-query index sets aligned with AdaSelect _test_candidate signature
+        qidxs: List[Set[IndexKey]] = []
+        for qi in query_infos:
+            qid = qi.qid
+            qidxs.append(set(cands_by_query.get(qid, set())) & topk_set)
+
+        # Partition candidates by table, ordered by score
+        cands_by_table: Dict[str, List[IndexKey]] = {}
+        for (tbl, _cols) in topk_set:
+            cands_by_table.setdefault(tbl, []).append((tbl, _cols))
+        for tbl, lst in cands_by_table.items():
+            lst.sort(key=lambda k: score_map.get(k, 0.0), reverse=True)
+
+        cov = self._coverage_ratio(query_infos, topk_set)
+        stats = CandidateStats(
+            candidate_count_raw=sum(len(v) for v in cands_by_query.values()),
+            wdcg_pruned_count=len(topk_set),
+            coverage_ratio=cov,
+            skipped_family_cap=skip_family,
+            skipped_dominated=skip_dom,
+        )
+
+        return CandidateResult(
+            topk=topk_set,
+            candidates_by_table=cands_by_table,
+            query_indexes=qidxs,
+            wdcg_score=score_map,
+            family_meta=family_meta,
+            stats=stats,
+            debug=debug,
+        )
+
+    def _select_topk(
+        self,
+        score_map: Dict[IndexKey, float],
+        family_meta: FamilyMeta,
+        query_infos: Sequence[QueryInfo],
+        cands_by_query: Dict[int, Set[IndexKey]],
+    ) -> Tuple[Set[IndexKey], int, int]:
+        """Constrained greedy selection with prefix-family caps and forward dominance skipping."""
+        ordered = sorted(score_map.items(), key=lambda kv: kv[1], reverse=True)
+
+        selected: Set[IndexKey] = set()
+        fam_cnt: Dict[int, int] = {}
+        skipped_family = 0
+        skipped_dom = 0
+
+        # coverage tracking
+        uncovered = self._uncovered_units(query_infos)
+        covered: Set[Tuple[int, str]] = set()
+
+        for idx, sc in ordered:
+            if len(selected) >= self.topk:
+                break
+
+            fam = family_meta.family_id.get(idx, 0)
+            cap = self.cap_family
+            if self.enable_coverage_boost and uncovered:
+                cov_ratio = 1.0 - (len(uncovered) / max(1, len(self._uncovered_units(query_infos))))
+                if cov_ratio < self.target_coverage:
+                    cap = self.cap_family + 1
+
+            if fam_cnt.get(fam, 0) >= cap:
+                skipped_family += 1
+                continue
+
+            # forward dominance: if some selected prefix has >= score, skip.
+            if self._is_dominated_by_selected_prefix(idx, sc, selected, score_map):
+                skipped_dom += 1
+                continue
+
+            selected.add(idx)
+            fam_cnt[fam] = fam_cnt.get(fam, 0) + 1
+
+            # update coverage
+            newly = self._covers_units(idx, query_infos)
+            covered |= newly
+            uncovered -= newly
+
+        return selected, skipped_family, skipped_dom
+
+    @staticmethod
+    def _is_dominated_by_selected_prefix(
+        idx: IndexKey,
+        score: float,
+        selected: Set[IndexKey],
+        score_map: Dict[IndexKey, float],
+    ) -> bool:
+        tbl, cols = idx
+        if len(cols) <= 1:
+            return False
+        for k in range(1, len(cols)):
+            p = (tbl, cols[:k])
+            if p in selected and score_map.get(p, float("-inf")) >= score:
+                return True
+        return False
+
+    @staticmethod
+    def _uncovered_units(query_infos: Sequence[QueryInfo]) -> Set[Tuple[int, str]]:
+        return {(qi.qid, t) for qi in query_infos for t in qi.tables}
+
+    @staticmethod
+    def _covers_units(idx: IndexKey, query_infos: Sequence[QueryInfo]) -> Set[Tuple[int, str]]:
+        tbl, cols = idx
+        res: Set[Tuple[int, str]] = set()
+        colset = set(cols)
+        for qi in query_infos:
+            if tbl not in qi.tables:
+                continue
+            rc = qi.roles.get(tbl)
+            if rc is None:
+                continue
+            pred = set(rc.join_eq) | set(rc.filter_eq) | set(rc.filter_rng)
+            if colset & pred:
+                res.add((qi.qid, tbl))
+        return res
+
+    @staticmethod
+    def _coverage_ratio(query_infos: Sequence[QueryInfo], topk: Set[IndexKey]) -> float:
+        if not query_infos:
+            return 1.0
+        total = 0
+        covered = 0
+        # any-hit on predicate columns (v1.1)
+        for qi in query_infos:
+            for t in qi.tables:
+                total += 1
+                pred: Set[str] = set()
+                rc = qi.roles.get(t)
+                if rc:
+                    pred |= set(rc.join_eq) | set(rc.filter_eq) | set(rc.filter_rng)
+                hit = False
+                for idx in topk:
+                    if idx[0] != t:
+                        continue
+                    if set(idx[1]) & pred:
+                        hit = True
+                        break
+                if hit:
+                    covered += 1
+        return covered / max(1, total)
