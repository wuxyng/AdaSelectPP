+# ---------------------------------------------------------
+# Helper Functions
+# ---------------------------------------------------------
+def _unique_preserve_order(cols):
+    seen = set()
+    return [x for x in cols if not (x in seen or seen.add(x))]
+
+
+def _canon(key: Tuple[Any, ...]) -> IndexKey:
+    if len(key) >= 2 and not isinstance(key[1], tuple):
+        return (key[0], tuple(key[1:]))
+    return key  # already canonical
+
+
+def _merge_prefixes(indexes: Set[IndexKey]) -> Set[IndexKey]:
+    """
+    Removes index keys that are prefixes of other index keys in the set.
+    Example: if (T, (a)) and (T, (a,b)) exist, (T, (a)) is removed.
+    """
+    # Sort by column length descending so we keep longest first
+    sorted_idxs = sorted(indexes, key=lambda x: len(x[1]), reverse=True)
+    kept = set()
+    for idx in sorted_idxs:
+        tbl, cols = idx
+        is_prefix = False
+        for k_tbl, k_cols in kept:
+            if k_tbl == tbl and len(cols) < len(k_cols) and k_cols[:len(cols)] == cols:
+                is_prefix = True
+                break
+        if not is_prefix:
+            kept.add(idx)
+    return kept
+
