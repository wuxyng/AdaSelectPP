+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Sequence, Set, Tuple
+
+from .enumerator import FamilyMeta, IndexKey
+from .template_extractor import QueryInfo
+
+
+@dataclass
+class WDCGDebug:
+    # per query top candidates (for tracing)
+    per_query_top: Dict[int, List[Tuple[IndexKey, float, float]]]  # (idx, rank_key, gain)
+    mu_init_source: Dict[IndexKey, str]  # 'prefix' | 'heuristic' | 'smooth'
+
+
+class WDCGRanker:
+    """Weighted DCG ranker for budget-aware candidate evaluation.
+
+    Design rationale:
+    - We need a *query-conditional* ordering (rank_key) but a *global* score used to
+      select a small set under a tight evaluation budget.
+    - We use Information Retrieval style log discount: candidates consistently ranked
+      high across queries accumulate more global score.
+    """
+
+    def __init__(
+        self,
+        w_role: float = 1.0,
+        w_freq: float = 0.3,
+        w_mu: float = 1.0,
+        rho_inherit: float = 0.7,
+        eps_gain: float = 1e-6,
+        enable_abs_mu_smooth: bool = True,
+    ):
+        self.w_role = float(w_role)
+        self.w_freq = float(w_freq)
+        self.w_mu = float(w_mu)
+        self.rho = float(rho_inherit)
+        self.eps = float(eps_gain)
+        self.enable_abs_mu_smooth = bool(enable_abs_mu_smooth)
+
+    def score(
+        self,
+        query_infos: Sequence[QueryInfo],
+        cands_by_query: Dict[int, Set[IndexKey]],
+        mu_smooth: Dict[IndexKey, float],
+        freq: Dict[Tuple[str, str], float],
+        family_meta: Optional[FamilyMeta] = None,
+        debug_topn: int = 20,
+    ) -> Tuple[Dict[IndexKey, float], WDCGDebug]:
+        # Precompute mu_init for all candidates
+        all_cands: Set[IndexKey] = set()
+        for s in cands_by_query.values():
+            all_cands |= s
+
+        mu_init: Dict[IndexKey, float] = {}
+        mu_src: Dict[IndexKey, str] = {}
+        for idx in all_cands:
+            mi = self._mu_init(idx, mu_smooth)
+            mu_init[idx] = mi
+            if mi > 0:
+                mu_src[idx] = "prefix"
+
+        # Compute global WDCG
+        score_map: Dict[IndexKey, float] = {idx: 0.0 for idx in all_cands}
+        per_query_top: Dict[int, List[Tuple[IndexKey, float, float]]] = {}
+
+        for qi in query_infos:
+            qid = qi.qid
+            cands = list(cands_by_query.get(qid, set()))
+            if not cands:
+                continue
+
+            # 1) query-local rank_key
+            rk: Dict[IndexKey, float] = {
+                idx: self._rank_key(idx, qi, mu_init[idx], freq) for idx in cands
+            }
+            cands.sort(key=lambda x: (rk.get(x, 0.0), score_map.get(x, 0.0)), reverse=True)
+
+            # 2) query-local gain
+            gain: Dict[IndexKey, float] = {
+                idx: self._gain(idx, qi, mu_smooth, mu_init[idx]) for idx in cands
+            }
+
+            # record debug
+            per_query_top[qid] = [
+                (idx, rk[idx], gain[idx]) for idx in cands[: max(0, int(debug_topn))]
+            ]
+
+            wq = float(getattr(qi, "weight", 1.0) or 1.0)
+
+            # DCG with log discount (pos starts at 1)
+            for pos, idx in enumerate(cands, start=1):
+                denom = math.log2(pos + 1.0)
+                score_map[idx] += wq * (gain[idx] / denom)
+
+        # mark source for remaining ones
+        for idx in all_cands:
+            if idx in mu_src:
+                continue
+            if idx in mu_smooth and (abs(mu_smooth[idx]) if self.enable_abs_mu_smooth else mu_smooth[idx]) > 0:
+                mu_src[idx] = "smooth"
+            else:
+                mu_src[idx] = "heuristic"
+
+        return score_map, WDCGDebug(per_query_top=per_query_top, mu_init_source=mu_src)
+
+    def _rank_key(
+        self,
+        idx: IndexKey,
+        qi: QueryInfo,
+        mu_init_val: float,
+        freq: Dict[Tuple[str, str], float],
+    ) -> float:
+        tbl, cols = idx
+        rc = qi.roles.get(tbl)
+        if rc is None:
+            role_score = 0.0
+        else:
+            # Prefer equality/join prefix; then range; then group/order.
+            eq_set = set(rc.join_eq) | set(rc.filter_eq)
+            rng_set = set(rc.filter_rng)
+            ord_set = set(rc.order_by) | set(rc.group_by)
+
+            role_score = 0.0
+            if cols:
+                if cols[0] in eq_set:
+                    role_score += 2.0
+                elif cols[0] in rng_set:
+                    role_score += 1.5
+                elif cols[0] in ord_set:
+                    role_score += 1.0
+            # additional columns
+            for c in cols[1:]:
+                if c in eq_set:
+                    role_score += 1.0
+                elif c in rng_set:
+                    role_score += 0.8
+                elif c in ord_set:
+                    role_score += 0.4
+
+        # frequency score (cheap prior)
+        fs = 0.0
+        for c in cols:
+            fs += float(freq.get((tbl, c), 0.0))
+
+        return self.w_role * role_score + self.w_freq * fs + self.w_mu * mu_init_val
+
+    def _h_gain(self, idx: IndexKey, qi: QueryInfo) -> float:
+        """Structure-based gain floor.
+
+        Purpose: avoid all-zero gains in pure cold-start (no mu_smooth, no mu_init).
+        We keep it small to avoid dominating when real evidence exists.
+        """
+        tbl, cols = idx
+        rc = qi.roles.get(tbl)
+        if rc is None:
+            return 1.0 if len(cols) == 1 else 1.1
+
+        eq_set = set(rc.join_eq) | set(rc.filter_eq)
+        rng_set = set(rc.filter_rng)
+        ord_set = set(rc.order_by) | set(rc.group_by)
+
+        g = 1.0 if len(cols) == 1 else 1.1
+        if any(c in eq_set for c in cols):
+            g += 0.2
+        if any(c in rng_set for c in cols):
+            g += 0.1
+        if any(c in ord_set for c in cols):
+            g += 0.05
+        return g
+
+    def _gain(
+        self,
+        idx: IndexKey,
+        qi: QueryInfo,
+        mu_smooth: Dict[IndexKey, float],
+        mu_init_val: float,
+    ) -> float:
+        ms = float(mu_smooth.get(idx, 0.0))
+        ms_val = abs(ms) if self.enable_abs_mu_smooth else ms
+        return max(self.eps, ms_val, mu_init_val, self._h_gain(idx, qi))
+
+    def _mu_init(self, idx: IndexKey, mu_smooth: Dict[IndexKey, float]) -> float:
+        """Decay inherited prior from best known prefix."""
+        tbl, cols = idx
+        if len(cols) <= 1:
+            return 0.0
+        best = 0.0
+        # only prefix chain (order sensitive)
+        for k in range(1, len(cols)):
+            p = (tbl, cols[:k])
+            if p in mu_smooth:
+                v = abs(float(mu_smooth[p])) if self.enable_abs_mu_smooth else float(mu_smooth[p])
+                v *= self.rho ** (len(cols) - k)
+                if v > best:
+                    best = v
+        return best
