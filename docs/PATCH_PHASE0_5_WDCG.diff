+    @staticmethod
+    def _minmax_norm_1(self, data: Dict[IndexKey, float]) -> Dict[IndexKey, float]:
+        if not data:
+            return {}
+        vals = data.values()
+        min_v, max_v = min(vals), max(vals)
+        if math.isclose(min_v, max_v):
+            return {k: 1.0 for k in data}
+        return {k: (v - min_v) / (max_v - min_v) for k, v in data.items()}
+
+    @staticmethod
+    def _minmax_norm(data: Dict[IndexKey, float]) -> Dict[IndexKey, float]:
+        """
+        Robust Max-Scale Normalization with Quantile Clipping.
+        Handles:
+        1. No positive benefits (Avoid Div/0)
+        2. Extreme outliers (Use P95 instead of Max)
+        3. Extreme negatives (Soft clipping)
+        """
+        if not data:
+            return {}
+
+        vals = list(data.values())
+
+        # --- 1. 提取正收益集合 Pt ---
+        # 使用 1e-9 过滤掉 0 和极小值
+        positive_vals = [v for v in vals if v > 1e-9]
+
+        # --- 2. 确定分母 Dt (Scale Factor) ---
+        scale_factor = 1.0  # 默认值 (对应 Pt 为空的情况，坑1修复)
+
+        if positive_vals:
+            # 坑 2 修复：使用 95% 分位数 (P95) 而非 Max
+            # 这能防止一个超级 Outlier 把其他好索引压扁到 0
+            sorted_pos = sorted(positive_vals)
+            p95_index = int(len(sorted_pos) * 0.95)
+            # 确保 index 不越界 (虽理论上不会)
+            p95_index = min(p95_index, len(sorted_pos) - 1)
+
+            p95_val = sorted_pos[p95_index]
+
+            # 再次防止 P95 也是极小值的情况
+            if p95_val > 1e-9:
+                scale_factor = p95_val
+
+        # --- 3. 归一化与截断 ---
+        normalized = {}
+        for k, v in data.items():
+            # 计算原始比例
+            norm_v = v / scale_factor
+
+            # 坑 2 补充：正向截断
+            # 超过 P95 的超级索引，分数限制在 1.0 (或 1.2/1.5，视偏好而定)
+            # 这里设为 1.0 意味着"只要达到 P95 水平，就是满分索引"
+            if norm_v > 1.0:
+                norm_v = 1.0
+
+            # 坑 3 补充：负向截断 (可选)
+            # 为了防止 -10000 这种数值在后续聚合中破坏权重
+            # 我们将其限制在 -2.0 (即：它是满分好索引的负两倍那么坏)
+            # 这足够让它被淘汰，又不会破坏数值系统
+            if norm_v < -2.0:
+                norm_v = -2.0
+
+            normalized[k] = norm_v
+
+        return normalized
