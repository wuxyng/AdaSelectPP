+    # ---------------------------------------------------------
+    # Core Adaptive Logic: Trigg's Tracking Signal
+    # ---------------------------------------------------------
+
+    def _calculate_adaptive_lambda_ema(self, idx: IndexKey, prediction: float, observation: float) -> float:
+        """
+        Trigg's Tracking Signal with Threshold-based Mapping & Cold Start Protection.
+        """
+        # [Fix 2] Cold Start Protection
+        # 如果是第一次计算该索引的 lambda，直接返回初始配置值，避免 TS 极端化
+        # 同时初始化误差统计，防止下次计算时 TS 飙升
+        if idx not in self.idx_alphas:
+            self.idx_error_smooth[idx] = 0.0
+            self.idx_abs_error_smooth[idx] = 0.0  # 初始误差设为0或小值
+            # 记录初始 lambda
+            self.idx_alphas[idx] = self.alpha_init
+            return self.alpha_init
+
+        error = observation - prediction
+
+        old_E = self.idx_error_smooth.get(idx, 0.0)
+        old_M = self.idx_abs_error_smooth.get(idx, 0.0)
+
+        new_E = self.beta_error * error + (1 - self.beta_error) * old_E
+        new_M = self.beta_error * abs(error) + (1 - self.beta_error) * old_M
+
+        self.idx_error_smooth[idx] = new_E
+        self.idx_abs_error_smooth[idx] = new_M
+
+        if new_M < 1e-9:
+            tracking_signal = 0.0
+        else:
+            tracking_signal = abs(new_E / new_M)
+
+        # [Fix 3] Non-linear Mapping (Trapezoidal)
+        # TS_low 以下认为是纯噪声 -> Max Lambda
+        # TS_high 以上认为是强漂移 -> Min Lambda
+        TS_low = 0.3
+        TS_high = 0.7
+
+        if tracking_signal <= TS_low:
+            raw_lambda = self.lambda_max
+        elif tracking_signal >= TS_high:
+            raw_lambda = self.lambda_min
+        else:
+            # Linear interpolation in [TS_low, TS_high]
+            ratio = (tracking_signal - TS_low) / (TS_high - TS_low)
+            raw_lambda = self.lambda_max - ratio * (self.lambda_max - self.lambda_min)
+
+        return max(self.lambda_min, min(self.lambda_max, raw_lambda))
+
+    def _calculate_adaptive_lambda(
+            self,
+            idx: IndexKey,
+            prediction: float,
+            observation: float,
+    ) -> float:
+        """
+        Adaptive lambda based on Trigg-style Tracking Signal.
+
+        - 我们把 idx_error_smooth 视作“带遗忘因子的 RSFE”（运行和）；
+        - idx_abs_error_smooth 视作“平滑的平均绝对误差 MAD”；
+        - TS = |RSFE| / (MAD + eps)，度量“系统性偏差 vs 正常波动”的强度；
+        - TS 小：误差基本随机波动 → lambda 接近 lambda_max（长记忆）；
+        - TS 大：误差长时间偏向某一侧 → lambda 接近 lambda_min（短记忆）。
+        """
+
+        # 1) Cold start：第一次看到这个索引，用 alpha_init
+        if idx not in self.idx_alphas:
+            # 初始化 RSFE 和 MAD
+            self.idx_error_smooth[idx] = 0.0  # RSFE_t
+            self.idx_abs_error_smooth[idx] = 0.0  # MAD_t
+            self.idx_alphas[idx] = self.alpha_init
+            return self.alpha_init
+
+        # 2) 当前预测误差（带符号）
+        error = observation - prediction
+
+        # 3) 读取历史 RSFE & MAD
+        old_rsfe = self.idx_error_smooth.get(idx, 0.0)
+        old_mad = self.idx_abs_error_smooth.get(idx, 0.0)
+
+        # 4) 更新 RSFE（运行和 + 轻微遗忘防止爆炸）
+        # rho 越接近 1，越接近“真·运行和”；可以在 __init__ 里配置 rsfe_decay，缺省 0.99
+        rho = getattr(self, "rsfe_decay", 0.99)
+        new_rsfe = rho * old_rsfe + error
+
+        # 5) 更新 MAD（平滑平均绝对误差）
+        beta = getattr(self, "beta_error", 0.2)
+        new_mad = beta * abs(error) + (1.0 - beta) * old_mad
+
+        self.idx_error_smooth[idx] = new_rsfe
+        self.idx_abs_error_smooth[idx] = new_mad
+
+        # 6) 计算 Tracking Signal
+        eps = 1e-9
+        if new_mad < eps:
+            ts = 0.0
+        else:
+            ts = abs(new_rsfe) / (new_mad + eps)
+
+        # 7) 把 TS 映射到 [lambda_min, lambda_max]
+        #    TS_low 以下认为“只有噪声”，TS_high 以上认为“强漂移”
+        #[TS_low, TS_high] = [1, 4] [0.5, 2.0]   或者[0.25, 1.0]
+        TS_low = getattr(self, "ts_low", 1)
+        TS_high = getattr(self, "ts_high", 4)
+        ts_clipped = max(0.0, min(ts, TS_high))
+
+        if ts_clipped <= TS_low:
+            raw_lambda = self.lambda_max
+        elif ts_clipped >= TS_high:
+            raw_lambda = self.lambda_min
+        else:
+            # 在 [TS_low, TS_high] 做线性插值
+            ratio = (ts_clipped - TS_low) / (TS_high - TS_low)
+            raw_lambda = self.lambda_max - ratio * (self.lambda_max - self.lambda_min)
+
+        adaptive_lambda = max(self.lambda_min, min(self.lambda_max, raw_lambda))
+        return adaptive_lambda
+
+    # ---------------------------------------------------------
